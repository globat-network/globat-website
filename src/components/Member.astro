---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { Member } from "@/types.ts";

import ExternalLink from "@/components/ExternalLink.astro";
interface Props {
  member: CollectionEntry<"team">;
}

import {
  Card,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";

const { member } = Astro.props;
const { Content } = await render(member);
---

<Card className="border-none bg-transparent shadow-none">
  <CardHeader className="flex flex-col items-center space-y-2.5 text-center">
    {
      member.data.image && (
        <img
          src={member.data.image.src}
          alt={member.data.imageAlt ?? member.data.name}
          class="h-44 w-44 rounded-full object-cover ring-1 ring-black/10 dark:ring-white/10"
        />
      )
    }
    <CardTitle className="w-full max-w-[18rem] text-xl font-semibold tracking-tight text-balance">
      {member.data.name}
    </CardTitle>
    <CardDescription className="w-full max-w-[18rem] text-sm leading-5 text-foreground/65">
      {member.data.institution}
    </CardDescription>
  </CardHeader>

  <CardContent className="prose prose-sm mx-auto w-full max-w-[18rem] pt-4 text-left text-muted-foreground">
    <Content />
  </CardContent>

  {
    member.data.links && (
      <CardFooter className="mx-auto flex w-full max-w-[18rem] flex-wrap justify-start gap-x-4 gap-y-2 pt-2">
        {Object.entries(member.data.links).map(([name, link]) => (
          <ExternalLink href={link}>
            {name}
          </ExternalLink>
        ))}
      </CardFooter>
    )
  }
</Card>
