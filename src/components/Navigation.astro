---
import { NAV_LINKS, SITE } from "@/siteConfig.ts";
import { MobileNav } from "@/components/MobileNav";
import { NavMenu } from "@/components/NavMenu.tsx";
---

<header
  class="relative z-10 mx-auto flex max-w-screen-lg flex-col gap-4 p-3 pb-6 font-sans sm:p-6 md:flex-row md:items-center md:justify-between md:pb-8"
>
  <div class="flex items-center justify-between gap-4">
    <a href="/" class="text-3xl font-semibold text-black dark:text-white"
      >{SITE.title}</a
    >
    <MobileNav links={Object.values(NAV_LINKS)} client:load />
  </div>
  <nav aria-label="Main" class="hidden md:block">
    <NavMenu links={Object.values(NAV_LINKS)} client:load />
  </nav>
</header>
