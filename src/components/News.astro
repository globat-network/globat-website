---
import { getCollection } from "astro:content";
import Post from "@/components/Post.astro";

const posts = (await getCollection("news")).sort(
  (a, b) => b.data.publicationDate.valueOf() - a.data.publicationDate.valueOf(),
);
---

<section class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
  <div class="max-w-3xl">
    <h2 class="text-muted-text dark:text-dark-muted-text mb-4 text-lg font-bold">
      News
    </h2>
    <div class="grid list-none gap-4 p-0">
      {posts.map((post) => <Post post={post} />)}
    </div>
  </div>
</section>
