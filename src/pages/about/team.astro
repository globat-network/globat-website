---
import BaseLayout from "@/layouts/BaseLayout.astro";

import SeoPage from "@/components/SeoPage.astro";
import Team from "@/components/Team.astro";
import MemberMap from "@/components/MemberMap.astro";
---

<BaseLayout>
  <SeoPage slot="head" title="GloBat Team" />

  <main class="py-6 sm:py-8">
    <div class="mx-auto max-w-screen-xl px-4 sm:px-6 lg:px-8">
      <section class="mt-4">
        <div class="mx-auto max-w-3xl text-center">
          <p class="text-sm font-semibold tracking-[0.18em] text-muted-foreground uppercase">
            Membership
          </p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
            A Global Network
          </h2>
          <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-foreground/80">
            We are a global community working at the intersection of bat
            research, conservation, and artificial intelligence (AI). Our
            members span the globe, bringing diverse expertise and a shared
            interest for leveraging AI to protect bat biodiversity.
          </p>
        </div>

        <div class="mx-auto mt-12 max-w-none">
          <MemberMap />
        </div>
      </section>

      <section class="mt-16 sm:mt-20">
        <div class="text-center">
          <p class="text-sm font-semibold tracking-[0.18em] text-muted-foreground uppercase">
            Leadership
          </p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">
            The Admin Team
          </h2>
          <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-foreground/80">
            We are the organisers and facilitators of the GloBat network.
          </p>
        </div>

        <div class="mt-12">
          <Team />
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
