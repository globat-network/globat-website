---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SeoPage from "@/components/SeoPage.astro";
---

<BaseLayout>
  <SeoPage slot="head" title="Contact" />
  <div class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <div class="max-w-3xl">
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Contact</h1>
      <p class="mt-4 text-lg leading-8 text-foreground/80">
        Use the links in this section to contact the GloBat team or learn how to get involved.
      </p>
    </div>
  </div>
</BaseLayout>
