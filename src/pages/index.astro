---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";

// import News from "@/components/News.astro";
import SeoPage from "@/components/SeoPage.astro";
import batImage from "@/images/bats/TrachopsMaslowski-5.jpg";
---

<BaseLayout>
  <SeoPage slot="head" />

  <div class="py-14 text-center sm:py-16">
    <div class="mx-auto max-w-4xl px-4">
      <p class="text-sm font-semibold tracking-[0.18em] text-muted-foreground uppercase">
        Global Research Network
      </p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-6xl">
        Advancing Bat Conservation Through Artificial Intelligence
      </h1>

      <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-foreground/80">
        GloBat is a scientific collaboration network accelerating the
        development and application of AI tools for bat acoustic monitoring and
        research. We bring together a diverse, global community of researchers,
        technologists, and conservationists to build the tools needed to expand
        our collective ability to understand bat populations and their
        behaviour.
      </p>

      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-x-5 sm:gap-y-0">
        <a
          href="/contact/membership"
          class="inline-flex min-h-11 items-center justify-center rounded-full bg-foreground px-5 py-3 text-sm font-semibold text-background transition hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
        >
          Become a Member
        </a>
        <a
          href="/about/mission"
          class="inline-flex min-h-11 items-center justify-center text-sm font-semibold text-foreground/80 transition hover:text-foreground"
        >
          Learn more <span aria-hidden="true" class="ml-1">→</span>
        </a>
      </div>

      <div class="mt-10">
        <Image
          src={batImage}
          alt="Bat flying against a dark background"
          class="w-full rounded-md object-cover ring-1 ring-zinc-900/10"
        />
      </div>
      <p class="mt-2 text-xs text-gray-500 italic">Photo by Grant Maslowski</p>
    </div>
  </div>
</BaseLayout>
